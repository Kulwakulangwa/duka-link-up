# ─── Supabase (public — safe to expose) ────────────────────────────────────
# Get these from: https://supabase.com/dashboard/project/<id>/settings/api
SUPABASE_PROJECT_ID="your-supabase-project-id"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_URL="https://your-project-id.supabase.co"

# Vite needs VITE_ prefixed versions for the browser bundle
VITE_SUPABASE_PROJECT_ID="your-supabase-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# ─── Supabase (server-only — NEVER commit this value) ───────────────────────
# REQUIRED: the server will throw on startup without this.
# Get it from: Supabase Dashboard > Settings > API > service_role (secret key)
# Add ONLY in Vercel dashboard: Settings > Environment Variables
SUPABASE_SERVICE_ROLE_KEY="eyJ..."
